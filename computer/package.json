{
  "name": "wayfind-computer",
  "version": "0.1.0",
  "private": true,
  "description": "Wayfind agent CLI + HTTP/SSE server that runs inside the cloud computer (MicroVM). Stack A: @openai/agents with opencode-shaped tools.",
  "type": "module",
  "bin": {
    "wayfind": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.18.0",
    "@openai/agents-openai": "^0.18.0",
    "dotenv": "^17.4.2",
    "openai": "^7.10.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
