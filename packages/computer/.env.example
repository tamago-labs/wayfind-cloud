# Provider + runtime config (copy to .env). Keys may also live in the
# VM keystore at $WORKSPACE_DIR/.wayfind/keys.json — env wins for P0.
# OpenAI-compatible base URL WITHOUT a path suffix — the SDK appends it.
PROVIDER_BASE_URL=https://api.meta.ai/v1
PROVIDER_MODEL=muse-spark-1.3
PROVIDER_API_KEY=

# Port for the agent HTTP/SSE server.
PORT=8080

# Workspace root (skills, mcp.json, conversations). In the MicroVM this
# will be /workspace; locally it defaults to ./workspace.
WORKSPACE_DIR=./workspace
