# Copy to scripts/microvm/.env and fill in. Never commit the real file
# (it is gitignored). Credentials come from your normal AWS setup
# (env vars / ~/.aws/credentials) — not from here.

# Region to test in. Our backend is ap-southeast-1 — M1 question #1 is
# whether MicroVMs are even offered there.
AWS_REGION=ap-southeast-1

# S3 bucket holding the image zip (create it first, same region as above).
MICROVM_BUCKET=wayfind-microvm-artifacts-ap-southeast-1

# IAM role Lambda assumes during image builds (see README for trust + perms).
MICROVM_BUILD_ROLE_ARN=arn:aws:iam::<account-id>:role/MicrovmBuildRole

# Managed base image for the region, e.g. al2023-1. If unsure, run
# `aws lambda-microvms list-managed-microvm-images --region <region>`.
MICROVM_BASE_IMAGE_ARN=arn:aws:lambda:<region>:aws:microvm-image:al2023-1

# Test image name (must be unique in the account).
MICROVM_IMAGE_NAME=wayfind-hello
